// Every example below is compiled by Main. '-----' separates them.

analysis by category = match transactionType {
    ['Cash', 'Cheques'] -> 'CASH_FLOW'
    ['Instrument'] -> 'INTERNAL_TRANSFER'
    _ -> 'OTHER'
} {
    incoming = sum(TransactionValue) when Direction = 'C'
    outgoing = sum(TransactionValue) when Direction = 'D'
    count()
}
over {
    ClientId in ['1', '3']
    TransactionDate in '2010-01-01'..'2019-12-31'
}
-----------------
analysis by country {
    incomingAmount = sum(TransactionValue) when Direction = 'C'
    incomingCount = count() when Direction = 'C'
}
over {
    ClientId in ['1', '3']
    TransactionDate in '2010-01-01'..'2019-12-31'
}
top 10 by incomingAmount
-----------------
// Same shape as the query above, different constants: this reuses the
// cached plan and only rebinds the parameters.
analysis by country {
    incomingAmount = sum(TransactionValue) when Direction = 'C'
    incomingCount = count() when Direction = 'C'
}
over {
    ClientId in ['2', '4']
    TransactionDate in '2015-01-01'..'2021-12-31'
}
top 10 by incomingAmount
-----------------
// Explicit variables. The plan advertises what it needs ($clients: list<string>,
// $from/$to: date) and the caller supplies them per request, so this query text
// is byte-identical on every call and hits the L1 cache.
analysis by country, year = year(TransactionDate) {
    total = sum(TransactionValue)
    largest = max(TransactionValue)
    distinctCounterparties = count(distinct counterpartyId)
}
over {
    clientId in $clients
    TransactionDate in $from..$to
    TransactionValue > 500
}
top $limit by total
-----------------
// Flat query: same filter and expression language, no grouping.
list {
    transactionId
    TransactionDate
    counterparty = counterpartyName
    country
    TransactionValue
    signedAmount = match { direction = 'C' -> TransactionValue, _ -> -TransactionValue }
}
over {
    clientId in ['1', '3']
    TransactionDate in '2010-01-01'..'2019-12-31'
    currency in ['CHF', 'EUR']
}
sort by TransactionDate desc, TransactionValue desc
top 5
-----------------
// Flat query with no 'top': the statement is emitted without a TOP clause,
// because the TAQL did not ask for one.
list {
    transactionId
    label = concat(upper(currency), ' ', transactionType)
}
over {
    TransactionValue > 1000 and (country = 'CH' or country = 'FR')
    transactionId not like 'X%'
}
sort by transactionId
-----------------
// Window functions: share of total and rank, computed over the grouped result.
analysis by Country {
    total = sum(TransactionValue)
    pct   = share(total)
    rk    = rank(total)
}
-----------------
// Top N per group. 'within' turns the global TOP into a per-group rank filter,
// so this is the two biggest counterparties in each country.
analysis by Country, CounterpartyName {
    total = sum(TransactionValue)
}
top 2 by total within Country
-----------------
// Period-over-period: lag() needs an explicit ordering to know which row
// comes before, and resets at each partition boundary.
analysis by Country, y = year(TransactionDate) {
    total = sum(TransactionValue)
    prev  = lag(total) within Country ordered by y
    growth = share(total) within Country
}

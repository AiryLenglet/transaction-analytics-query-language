// Every example below is compiled by Main. '-----' separates them.

analysis by category = match transactionType {
    ['Cash', 'Cheques'] -> 'CASH_FLOW'
    ['Instrument'] -> 'INTERNAL_TRANSFER'
    _ -> 'OTHER'
} {
    incoming = sum(TransactionValue) when Direction = 'C'
    outgoing = sum(TransactionValue) when Direction = 'D'
    count()
}
over {
    ClientId in ['1', '3']
    date in '2010-01-01'..'2019-12-31'
}
-----------------
analysis by country {
    incomingAmount = sum(TransactionValue) when Direction = 'C'
    incomingCount = count() when Direction = 'C'
}
top 10 by incomingAmount
over {
    ClientId in ['1', '3']
    date in '2010-01-01'..'2019-12-31'
}
-----------------
// Same shape as the query above, different constants: this reuses the
// cached plan and only rebinds the parameters.
analysis by country {
    incomingAmount = sum(TransactionValue) when Direction = 'C'
    incomingCount = count() when Direction = 'C'
}
top 10 by incomingAmount
over {
    ClientId in ['2', '4']
    date in '2015-01-01'..'2021-12-31'
}
-----------------
// Explicit variables. The plan advertises what it needs ($clients: list<string>,
// $from/$to: date) and the caller supplies them per request, so this query text
// is byte-identical on every call and hits the L1 cache.
analysis by country, year = year(date) {
    total = sum(amount)
    largest = max(amount)
    distinctCounterparties = count(distinct counterpartyId)
}
top $limit by total
over {
    clientId in $clients
    date in $from..$to
    amount > 500
}
-----------------
// Flat query: same filter and expression language, no grouping.
list {
    transactionId
    date
    counterparty = counterpartyName
    country
    amount
    signedAmount = match { direction = 'C' -> amount, _ -> -amount }
}
over {
    clientId in ['1', '3']
    date in '2010-01-01'..'2019-12-31'
    currency in ['CHF', 'EUR']
}
sort by date desc, amount desc
top 5
-----------------
// Flat query with no 'top': the compiler injects the configured row cap so a
// REST caller cannot ask for the whole table.
list {
    transactionId
    label = concat(upper(currency), ' ', transactionType)
}
over {
    amount > 1000 and (country = 'CH' or country = 'FR')
    transactionId not like 'X%'
}
sort by transactionId
